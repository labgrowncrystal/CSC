{
	"schemaVersion": 1,
	"id": "csc",
	"version": "${version}",
	"name": "Clientside Chat (CSC)",
	"description": "Server-Admin Private P2P Messaging for Minecraft — Zero server-side plugins or external web servers required. Features ECDH Key Exchange, AES-256-GCM E2EE, Host Key Pinning, Audio Feedback, Whispering & Bookmarks.",
	"authors": ["WantingHades901", "LabGrownCrystal"],
	"contact": {
		"homepage": "https://github.com/labgrowncrystal/CSC",
		"sources": "https://github.com/labgrowncrystal/CSC",
		"issues": "https://github.com/labgrowncrystal/CSC/issues"
	},
	"license": "MIT",
	"icon": "assets/csc/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": ["dev.csc.CSCMod"],
		"client": ["dev.csc.client.CSCClient"]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"fabric-api": "*",
		"minecraft": "~26.2",
		"java": ">=25"
	},
	"custom": {
		"modmenu": {
			"badges": ["client"],
			"links": {
				"modmenu.github": "https://github.com/labgrowncrystal/CSC"
			}
		}
	}
}
